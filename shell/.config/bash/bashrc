# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Source shell agnostic config
. "$XDG_CONFIG_HOME/shell/env.sh"
. "$XDG_CONFIG_HOME/shell/path.sh"
. "$XDG_CONFIG_HOME/shell/aliases.sh"
. "$XDG_CONFIG_HOME/shell/init.sh"

# Docker aliases with completions
. /usr/share/bash-completion/completions/docker
alias d='docker'
complete -o default -F __start_docker d
alias c='docker compose'
_docker_compose_wrapper() {
  COMP_LINE="docker compose${COMP_LINE:1}"
  COMP_WORDS=(docker compose "${COMP_WORDS[@]:1}")
  ((COMP_POINT+=13))
  ((COMP_CWORD+=1))
  __start_docker
}
complete -o default -F _docker_compose_wrapper c

# Bash prompt
__prompt_command() {
  local exit=$?
  local prompt='$'
  local colors=$(tput colors 2>/dev/null || echo 0)

  if [ "$colors" -ge 256 ]; then
    local GRAY='\[\e[38;5;240m\]'
    local GREEN='\[\e[38;5;46m\]'
    local YELLOW='\[\e[38;5;226m\]'
    local RED='\[\e[38;5;196m\]'
    local BLUE='\[\e[38;5;39m\]'
  elif [ "$colors" -ge 16 ]; then
    local GRAY='\[\e[90m\]'
    local GREEN='\[\e[92m\]'
    local YELLOW='\[\e[93m\]'
    local RED='\[\e[91m\]'
    local BLUE='\[\e[94m\]'
  else
    local GRAY='\[\e[37m\]'
    local GREEN='\[\e[32m\]'
    local YELLOW='\[\e[33m\]'
    local RED='\[\e[31m\]'
    local BLUE='\[\e[34m\]'
  fi
  local RESET='\[\e[0m\]'

  local MAPFILE
  mapfile -tn 2 MAPFILE < ~/.bashrc
  if [ "${#MAPFILE[@]}" -gt 1 ]; then
    prompt='þ'
    local color="$RED"
    local cwd="${PWD/#$HOME/\~}"
    local dir="${cwd%/*}"
    local base="${cwd##*/}"
    [ "$cwd" = "$base" ] && dir=""
    [ -n "$dir" ] && PS1="${GRAY}${dir}/${RESET}${base} ${color}${prompt}${RESET} " || PS1="${base} ${color}${prompt}${RESET} "
    return
  fi

  [ "$EUID" -eq 0 ] && prompt='#'

  local cwd="${PWD/#$HOME/\~}"
  local dir="${cwd%/*}"
  local base="${cwd##*/}"
  [ "$cwd" = "$base" ] && dir=""

  if [ "$exit" -ne 0 ]; then
    local color="$RED"

    case "$exit" in
      2|3|16|64|65|66|67|68|69|75|78|125|127|128)
        color="$YELLOW"
        ;;
      129|130|131|141|142|148)
        color="$BLUE"
        ;;
    esac

    case "$exit" in
      1)   prompt='!'  ;;
      2)   prompt='€'  ;;
      3)   prompt='Æ'  ;;
      16)  prompt='M'  ;;
      64)  prompt='¿'  ;;
      65)  prompt='%'  ;;
      66)  prompt='«'  ;;
      67)  prompt='µ'  ;;
      68)  prompt='@'  ;;
      69)  prompt='ø'  ;;
      70)  prompt='£'  ;;
      71)  prompt='œ'  ;;
      72)  prompt='ƒ'  ;;
      73)  prompt='+'  ;;
      74)  prompt='|'  ;;
      75)  prompt='…'  ;;
      76)  prompt='¶'  ;;
      77)  prompt='©'  ;;
      78)  prompt='ç'  ;;
      101) prompt='®'  ;;
      125) prompt='Ð'  ;;
      126) prompt='×'  ;;
      127) prompt='?'  ;;
      128) prompt='§'  ;;
      129) prompt='¥'  ;;
      130) prompt='¢'  ;;
      131) prompt='\\' ;;
      132) prompt='¡'  ;;
      133) prompt='»'  ;;
      134) prompt='‡'  ;;
      135) prompt='ß'  ;;
      136) prompt='÷'  ;;
      137) prompt='ð'  ;;
      139) prompt='‰'  ;;
      141) prompt='¦'  ;;
      142) prompt='ö'  ;;
      143) prompt='†'  ;;
      147) prompt='¬'  ;;
      148) prompt='&'  ;;
      255) prompt='&'  ;;
      *)   prompt="($exit)" ;;
    esac

    [ -n "$dir" ] && PS1="${GRAY}${dir}/${RESET}${base} ${color}${prompt}${RESET} " || PS1="${base} ${color}${prompt}${RESET} "
  else
    [ -n "$dir" ] && PS1="${GRAY}${dir}/${RESET}${base} ${GREEN}${prompt}${RESET} " || PS1="${base} ${GREEN}${prompt}${RESET} "
  fi
}

PROMPT_COMMAND=__prompt_command
