#!/usr/bin/env bash

GRAY="#[fg=colour240]"
BLUE="#[fg=colour39]"
RESET="#[default]"

win_id="$1"
win_idx="$2"
is_active="$3"

pane_info=$(tmux list-panes -t "$win_id" -F "#{pane_active}:#{pane_current_command}:#{pane_current_path}" | grep "^1:")
IFS=':' read -r _ cmd path <<< "$pane_info"

basename="${path##*/}"

branch=""
if [ -d "$path/.git" ] || git -C "$path" rev-parse --git-dir &>/dev/null 2>&1; then
  branch=$(git -C "$path" branch --show-current 2>/dev/null)
  branch="${branch//\//-}"
fi

if [ "$is_active" = "1" ]; then
  output="${BLUE}${cmd} -${win_idx} ${basename}${RESET}"
else
  output="${cmd} -${win_idx} ${basename}"
fi

[ -n "$branch" ] && output+=" ${GRAY}--${branch}${RESET}"

echo -n "$output"
