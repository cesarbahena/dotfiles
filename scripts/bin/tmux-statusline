#!/usr/bin/env bash

GRAY="#[fg=colour240]"
GREEN="#[fg=colour46]"
RED="#[fg=colour196]"
RESET="#[default]"

USER=$(whoami)
HOST=$(hostname -s)

# SSH detection - recursively check children
check_descendants() {
  local pid=$1
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    if tr '\0' '\n' < /proc/$child/environ 2>/dev/null | grep -qE '^SSH_(CONNECTION|TTY)='; then
      return 0
    fi
    if check_descendants "$child"; then
      return 0
    fi
  done
  return 1
}

PANE_PID="${1:-}"
IS_SSH=false

if [[ -n "$PANE_PID" ]]; then
  if check_descendants "$PANE_PID"; then
    IS_SSH=true
  fi
fi

if [[ "$IS_SSH" == "true" ]]; then
  USER_HOST="${GREEN}${USER}@${HOST}"
else
  USER_HOST="${GRAY}${USER}@${HOST}"
fi

echo -n "${USER_HOST} ${RESET}"
