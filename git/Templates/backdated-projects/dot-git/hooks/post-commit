#!/bin/sh
# post-commit hook for backdated repositories
# Injects random seconds, randomized minutes, and harmonized dates into commit timestamps via amend
# Uses CHOSEN_DATE from prepare-commit-msg so both author and committer use the same date

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
SENTINEL_DIR="$GIT_DIR/backdate-hook"

if [ -f "$SENTINEL_DIR/amending" ]; then
    rm -f "$SENTINEL_DIR/amending"
    rm -f "$SENTINEL_DIR/seconds"
    rm -f "$SENTINEL_DIR/rand_hour"
    rm -f "$SENTINEL_DIR/rand_minute"
    rm -f "$SENTINEL_DIR/chosen_date"
    rm -f "$SENTINEL_DIR/last_full_msg"
    rmdir "$SENTINEL_DIR" 2>/dev/null
    exit 0
fi

SEC_FILE="$SENTINEL_DIR/seconds"
if [ ! -f "$SEC_FILE" ]; then
    exit 0
fi

SEC="$(cat "$SEC_FILE")"
rm -f "$SEC_FILE"

CHOSEN_DATE_FILE="$SENTINEL_DIR/chosen_date"
RAND_HOUR_FILE="$SENTINEL_DIR/rand_hour"
RAND_MINUTE_FILE="$SENTINEL_DIR/rand_minute"

if [ -f "$CHOSEN_DATE_FILE" ]; then
    CHOSEN_DATE="$(cat "$CHOSEN_DATE_FILE")"
    rm -f "$CHOSEN_DATE_FILE"

    CHOSEN_HOUR="${CHOSEN_DATE##* }"
    CHOSEN_HOUR="${CHOSEN_HOUR%%:*}"
    CHOSEN_MINUTE="${CHOSEN_DATE##*:}"

    if [ -f "$RAND_HOUR_FILE" ] && [ -f "$RAND_MINUTE_FILE" ]; then
        RAND_H="$(cat "$RAND_HOUR_FILE")"
        RAND_M="$(cat "$RAND_MINUTE_FILE")"
        rm -f "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE"

        NEW_AUTHOR_DATE="$(date -d "$CHOSEN_DATE" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null | sed -E "s/[0-9]{2}:[0-9]{2}:[0-9]{2}/$(printf '%02d' "$RAND_H"):$(printf '%02d' "$RAND_M"):$(printf '%02d' "$SEC")/")"
    else
        rm -f "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE" 2>/dev/null
        NEW_AUTHOR_DATE="$(date -d "$CHOSEN_DATE" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null | sed "s/:[0-9][0-9] /:$SEC /")"
    fi

    NEW_COMMITTER_DATE="$NEW_AUTHOR_DATE"
else
    rm -f "$CHOSEN_DATE_FILE" "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE" 2>/dev/null

    CURRENT_AUTHOR_DATE="$(git log -1 --format='%ai')"
    CURRENT_COMMITTER_DATE="$(git log -1 --format='%ci')"

    if [ -f "$RAND_HOUR_FILE" ] && [ -f "$RAND_MINUTE_FILE" ]; then
        RAND_H="$(cat "$RAND_HOUR_FILE")"
        RAND_M="$(cat "$RAND_MINUTE_FILE")"
        rm -f "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE"

        NEW_AUTHOR_DATE="$(echo "$CURRENT_AUTHOR_DATE" | sed -E "s/[0-9]{2}:[0-9]{2}:[0-9]{2} /$(printf '%02d' "$RAND_H"):$(printf '%02d' "$RAND_M"):$(printf '%02d' "$SEC") /")"
        NEW_COMMITTER_DATE="$(echo "$CURRENT_COMMITTER_DATE" | sed -E "s/[0-9]{2}:[0-9]{2}:[0-9]{2} /$(printf '%02d' "$RAND_H"):$(printf '%02d' "$RAND_M"):$(printf '%02d' "$SEC") /")"
    else
        NEW_AUTHOR_DATE="$(echo "$CURRENT_AUTHOR_DATE" | sed "s/:[0-9][0-9] /:$SEC /")"
        NEW_COMMITTER_DATE="$(echo "$CURRENT_COMMITTER_DATE" | sed "s/:[0-9][0-9] /:$SEC /")"
    fi
fi

touch "$SENTINEL_DIR/amending"
GIT_COMMITTER_DATE="$NEW_COMMITTER_DATE" git commit --amend --no-edit --date="$NEW_AUTHOR_DATE" >/dev/null 2>&1

exit 0