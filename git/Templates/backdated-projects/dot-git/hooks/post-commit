#!/bin/sh
# post-commit hook for backdated repositories
# Injects random seconds and randomized minutes into commit timestamps via amend

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
SENTINEL_DIR="$GIT_DIR/backdate-hook"

if [ -f "$SENTINEL_DIR/amending" ]; then
    rm -f "$SENTINEL_DIR/amending"
    rm -f "$SENTINEL_DIR/seconds"
    rm -f "$SENTINEL_DIR/rand_hour"
    rm -f "$SENTINEL_DIR/rand_minute"
    rmdir "$SENTINEL_DIR" 2>/dev/null
    exit 0
fi

SEC_FILE="$SENTINEL_DIR/seconds"
if [ ! -f "$SEC_FILE" ]; then
    exit 0
fi

SEC="$(cat "$SEC_FILE")"
rm -f "$SEC_FILE"

RAND_HOUR_FILE="$SENTINEL_DIR/rand_hour"
RAND_MINUTE_FILE="$SENTINEL_DIR/rand_minute"

CURRENT_AUTHOR_DATE="$(git log -1 --format='%ai')"
CURRENT_COMMITTER_DATE="$(git log -1 --format='%ci')"

if [ -f "$RAND_HOUR_FILE" ] && [ -f "$RAND_MINUTE_FILE" ]; then
    RAND_H="$(cat "$RAND_HOUR_FILE")"
    RAND_M="$(cat "$RAND_MINUTE_FILE")"
    rm -f "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE"

    NEW_AUTHOR_DATE="$(echo "$CURRENT_AUTHOR_DATE" | sed -E "s/[0-9]{2}:[0-9]{2}:$(printf '%02d' "$SEC") /$(printf '%02d' "$RAND_H"):$(printf '%02d' "$RAND_M"):$(printf '%02d' "$SEC") /")"
    NEW_COMMITTER_DATE="$(echo "$CURRENT_COMMITTER_DATE" | sed -E "s/[0-9]{2}:[0-9]{2}:$(printf '%02d' "$SEC") /$(printf '%02d' "$RAND_H"):$(printf '%02d' "$RAND_M"):$(printf '%02d' "$SEC") /")"
else
    rm -f "$RAND_HOUR_FILE" "$RAND_MINUTE_FILE" 2>/dev/null
    NEW_AUTHOR_DATE="$(echo "$CURRENT_AUTHOR_DATE" | sed "s/:[0-9][0-9] /:$SEC /")"
    NEW_COMMITTER_DATE="$(echo "$CURRENT_COMMITTER_DATE" | sed "s/:[0-9][0-9] /:$SEC /")"
fi

touch "$SENTINEL_DIR/amending"
GIT_COMMITTER_DATE="$NEW_COMMITTER_DATE" git commit --amend --no-edit --date="$NEW_AUTHOR_DATE"

exit 0
