#!/usr/bin/env python3
"""
py - unified Python environment runner
Combines venv and conda environment management with auto-detection
"""

import sys
import os
import subprocess
from pathlib import Path


def find_venv(start_dir=None):
    """Find .venv or venv in current or parent directories"""
    if start_dir is None:
        dir_path = Path.cwd()
    else:
        dir_path = Path(start_dir).resolve()

    # Search up to 5 levels
    for _ in range(5):
        # Check for .venv first (preferred)
        venv_path = dir_path / ".venv"
        if venv_path.is_dir():
            return venv_path

        # Then check for venv
        venv_path = dir_path / "venv"
        if venv_path.is_dir():
            return venv_path

        # Move to parent
        parent = dir_path.parent
        if parent == dir_path:  # Reached root
            break
        dir_path = parent

    return None


def conda_env_exists(env_name):
    """Check if a conda environment exists by looking in the envs folder."""
    # Avoid checking for names that are invalid as directory names
    if '/' in env_name or '\\' in env_name or not env_name or env_name == '.':
        return False

    conda_locations = [Path.home() / "anaconda3", Path.home() / "miniconda3"]

    if env_name == 'base':
        # For 'base', just check if a conda installation directory exists.
        return any(loc.is_dir() for loc in conda_locations)

    for conda_base in conda_locations:
        if conda_base.is_dir():
            env_path = conda_base / "envs" / env_name
            if env_path.is_dir():
                return True
    
    return False


def activate_venv(venv_path, python_args, show_venv=False):
    """Activate venv with smart fast-path detection."""
    python_bin = venv_path / "bin" / "python"
    activate_script = venv_path / "bin" / "activate"

    if not python_bin.exists():
        print("Error: Python not found in virtual environment:", file=sys.stderr)
        print("  {}".format(python_bin), file=sys.stderr)
        sys.exit(1)

    if show_venv:
        print("Using venv: {}".format(venv_path), file=sys.stderr)

    # FAST PATH: Already in the target venv (~1ms)
    current_venv = os.environ.get('VIRTUAL_ENV')
    if current_venv and Path(current_venv).resolve() == venv_path.resolve():
        # Already in correct venv, just exec
        env = os.environ.copy()
        os.execve(str(python_bin), [str(python_bin)] + python_args, env)

    # NORMAL PATH: Source activate script for reliability
    if activate_script.exists():
        # Build python command with proper escaping
        python_cmd_parts = []
        for arg in python_args:
            escaped = arg.replace("'", "'\\''")
            python_cmd_parts.append("'{}'".format(escaped))
        python_cmd = ' '.join(python_cmd_parts)

        shell_script = """
source "{}" || exit 1
exec python {}
""".format(activate_script, python_cmd)
        os.execv("/bin/bash", ["/bin/bash", "-c", shell_script])
    else:
        # Fallback: direct exec with env vars (activate script missing)
        env = os.environ.copy()
        env['VIRTUAL_ENV'] = str(venv_path)
        env['PATH'] = str(venv_path / "bin") + ":" + env.get('PATH', '')
        os.execve(str(python_bin), [str(python_bin)] + python_args, env)


def activate_conda(env_name, python_args):
    """Activate conda env with smart fast-path detection."""
    current_env = os.environ.get('CONDA_DEFAULT_ENV')
    conda_prefix = os.environ.get('CONDA_PREFIX')

    # FAST PATH: Already in the target environment (~1ms)
    if current_env == env_name and conda_prefix:
        python_bin = Path(conda_prefix) / "bin" / "python"
        if python_bin.exists():
            # Inherit all conda environment variables, just exec
            env = os.environ.copy()
            os.execve(str(python_bin), [str(python_bin)] + python_args, env)

    # MEDIUM PATH: Conda initialized, just switch environments (~200ms)
    if 'CONDA_EXE' in os.environ:
        conda_exe = os.environ['CONDA_EXE']
        # Build python command with proper escaping
        python_cmd_parts = []
        for arg in python_args:
            escaped = arg.replace("'", "'\\''")
            python_cmd_parts.append("'{}'".format(escaped))
        python_cmd = ' '.join(python_cmd_parts)

        shell_script = """
eval "$({}) shell.bash hook)" || exit 1
conda activate "{}" || exit 1
exec python {}
""".format(conda_exe, env_name, python_cmd)
        os.execv("/bin/bash", ["/bin/bash", "-c", shell_script])

    # SLOW PATH: Conda not initialized, full setup (~300ms for stateless shells)
    conda_base = None
    conda_locations = [Path.home() / "anaconda3", Path.home() / "miniconda3"]
    for loc in conda_locations:
        if loc.is_dir():
            conda_base = loc
            break

    if not conda_base:
        print("Error: conda installation not found (looked in ~/anaconda3, ~/miniconda3)", file=sys.stderr)
        sys.exit(1)

    conda_bin = conda_base / "bin" / "conda"
    if not conda_bin.exists():
        print("Error: conda binary not found at {}".format(conda_bin), file=sys.stderr)
        sys.exit(1)

    # Build python command with proper escaping
    python_cmd_parts = []
    for arg in python_args:
        escaped = arg.replace("'", "'\\''")
        python_cmd_parts.append("'{}'".format(escaped))
    python_cmd = ' '.join(python_cmd_parts)

    shell_script = """
eval "$({} shell.bash hook)" || exit 1
conda activate "{}" || exit 1
exec python {}
""".format(conda_bin, env_name, python_cmd)
    os.execv("/bin/bash", ["/bin/bash", "-c", shell_script])


def activate_global(python_args):
    """Run system Python with clean environment (escape hatch from conda/venv)"""
    # Try to find system Python (prefer /usr/bin/python3)
    system_python = None

    for candidate in ["/usr/bin/python3", "/usr/bin/python", "/bin/python3", "/bin/python"]:
        if os.path.exists(candidate):
            system_python = candidate
            break

    if not system_python:
        print("Error: Could not find system Python", file=sys.stderr)
        print("Tried: /usr/bin/python3, /usr/bin/python, /bin/python3, /bin/python", file=sys.stderr)
        sys.exit(1)

    # Build clean environment without conda/venv pollution
    clean_env = {
        'HOME': os.environ.get('HOME', ''),
        'USER': os.environ.get('USER', ''),
        'LOGNAME': os.environ.get('LOGNAME', ''),
        'SHELL': os.environ.get('SHELL', '/bin/bash'),
        'TERM': os.environ.get('TERM', 'xterm'),
        'PATH': '/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin',
        'LANG': os.environ.get('LANG', 'en_US.UTF-8'),
    }

    # Execute with clean environment
    os.execve(system_python, [system_python] + python_args, clean_env)


def print_help():
    help_text = """py - unified Python environment runner

USAGE:
  py [--venv|--conda env] [script|module|command] [args...]
  py ... -c "code"          Force command mode
  py ... -m module          Force module mode
  py ... -i                 Enter REPL
  py -g ...                 Use system Python (escape hatch)
  py -h | --help            Show this help

MODES:
  --venv   Force virtual environment mode (searches for .venv or venv)
  --conda  Force conda environment mode (requires env name)
  -g       Use system Python with clean environment (ignores activated conda/venv)
  -c       Run a command string
  -m       Run a library module

AUTO-DETECTION:
  - Environment: If the first argument is a directory, a venv is assumed.
    If it's a string that matches a conda environment, that is used.
  - Execution: If no -c or -m flag is provided, py tries to be smart:
    - If arg is a file/dir           -> runs as a script
    - If arg contains '.' but not a file -> runs with -m
    - If arg is quoted with spaces   -> runs with -c
    - Otherwise, it's treated as a script path.

EXAMPLES:
  py -i                          # Use venv in current/parent dir, start REPL
  py ml train.py                 # Use conda env 'ml' to run train.py
  py . app/main.py               # Use venv in current dir to run app/main.py
  py http.server 8000            # Smart-detects and runs 'python -m http.server 8000'
  py "import sys; print(sys.version)" # Smart-detects and runs with -c
  py --conda ml -m my_module     # Force conda mode and module execution
  py -g script.py                # Use system Python (even inside conda/venv)
"""
    print(help_text)


def _parse_python_execution_args(args):
    """
    Parses arguments intended for python execution, applying smart detection.
    Returns a list of arguments to be passed to the python interpreter.
    """
    python_args = []

    if not args:
        return ['-i'] # Default to interactive mode if no arguments

    first_arg = args[0]

    # 1. Explicit flags
    if first_arg in ['-h', '--help']:
        print_help() # This function exits
        sys.exit(0)
    elif first_arg == '-c':
        if len(args) < 2:
            print("Error: -c requires a command string.", file=sys.stderr)
            sys.exit(1)
        # Arguments are already in the correct format for `python -c`
        python_args = args
    elif first_arg == '-m':
        if len(args) < 2:
            print("Error: -m requires a module name.", file=sys.stderr)
            sys.exit(1)
        # Arguments are already in the correct format for `python -m`
        python_args = args
    elif first_arg == '-i':
        # Arguments are already in the correct format for `python -i`
        python_args = args
    # 2. Auto-detection
    else:
        is_file_or_dir = os.path.exists(first_arg)

        if is_file_or_dir:
            # Treat as a script/directory to run
            python_args = args
        elif ' ' in first_arg or '(' in first_arg:
            # Contains a space or parenthesis -> likely a command string
            python_args = ['-c'] + args
        elif '.' in first_arg and not first_arg.startswith('.') and '/' not in first_arg:
            # Has internal dots, not a path or hidden file -> likely a module
            # Examples: http.server, my.module (not ./script, .config, ../)
            python_args = ['-m'] + args
        else:
            # Default: treat as a script path. Python will error if not found.
            # Example: `my_script_without_ext` or `my_script.py` (if not found in PATH)
            python_args = args
    
    # Ensure -i is included if specified
    # The new logic makes this less prone to issues, but keep for robustness
    if '-i' in args and '-i' not in python_args:
        python_args.append('-i')
    
    return python_args


def main():
    # Handle help early
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help']:
        print_help()
        sys.exit(0)

    # Handle global/system Python mode early (escape hatch)
    if len(sys.argv) > 1 and sys.argv[1] == '-g':
        # Parse remaining Python arguments using the new helper
        args = sys.argv[2:]
        python_args = _parse_python_execution_args(args)
        activate_global(python_args)
        # activate_global calls exec, so we never return here

    # Parse mode flags
    force_mode = None
    args = sys.argv[1:]

    if args and args[0] == '--venv':
        force_mode = 'venv'
        args = args[1:]
    elif args and args[0] == '--conda':
        force_mode = 'conda'
        args = args[1:]

    # Determine environment
    env_arg = None
    mode = force_mode

    if args and not args[0].startswith('-'):
        potential_env = args[0]

        if force_mode == 'venv':
            # Treat as directory for venv search
            env_arg = potential_env
            args = args[1:]
        elif force_mode == 'conda':
            # Treat as conda env name
            env_arg = potential_env
            args = args[1:]
        else:
            # Auto-detect
            is_dir = os.path.isdir(potential_env) or potential_env == '.'

            # Optimization: Skip expensive conda check in obvious cases
            # If it looks like a path or has .py extension, it's not a conda env
            looks_like_conda_env = (
                not ('/' in potential_env or '\\' in potential_env) and
                not potential_env.endswith('.py')
            )

            # Only check conda if it could plausibly be a conda env name
            if looks_like_conda_env and not is_dir:
                # Not a dir, might be conda env
                is_conda = conda_env_exists(potential_env)
            elif looks_like_conda_env and is_dir:
                # It's a dir, but check if it's also a conda env (rare ambiguous case)
                is_conda = conda_env_exists(potential_env)
            else:
                # Definitely not a conda env (has path separators or .py extension)
                is_conda = False

            if is_dir and is_conda:
                # Ambiguous case
                print("Warning: '{}' is both a directory and conda env. Using venv mode.".format(potential_env), file=sys.stderr)
                print("  Use --venv or --conda to force a specific mode.", file=sys.stderr)
                mode = 'venv'
                env_arg = potential_env
                args = args[1:]
            elif is_dir:
                mode = 'venv'
                env_arg = potential_env
                args = args[1:]
            elif is_conda:
                mode = 'conda'
                env_arg = potential_env
                args = args[1:]
            else:
                # Not a dir, not a conda env - might be a script or flag
                # Default to venv mode with current directory
                mode = 'venv'
                env_arg = None
    else:
        # No env arg or starts with flag - default to venv
        if not mode:
            mode = 'venv'

    # Parse Python arguments using the new helper
    python_args = _parse_python_execution_args(args)

    # Execute based on mode
    if mode == 'venv':
        venv_path = find_venv(env_arg)

        if not venv_path:
            print("Error: No virtual environment found (.venv or venv)", file=sys.stderr)
            print("Searched current directory and parents.", file=sys.stderr)
            print("", file=sys.stderr)
            print("To create one: python -m venv .venv", file=sys.stderr)
            sys.exit(1)

        activate_venv(venv_path, python_args, show_venv=(python_args == ['-i']))

    elif mode == 'conda':
        if not env_arg:
            print("Error: No conda environment name provided.", file=sys.stderr)
            print("Run 'py --help' for usage.", file=sys.stderr)
            sys.exit(1)

        activate_conda(env_arg, python_args)

    else:
        print("Error: Unable to determine mode.", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
