#!/usr/bin/env python3
"""
py - unified Python environment runner
Combines venv and conda environment management with auto-detection
"""

import sys
import os
import subprocess
from pathlib import Path


def find_venv(start_dir=None):
    """Find .venv or venv in current or parent directories"""
    if start_dir is None:
        dir_path = Path.cwd()
    else:
        dir_path = Path(start_dir).resolve()

    # Search up to 5 levels
    for _ in range(5):
        # Check for .venv first (preferred)
        venv_path = dir_path / ".venv"
        if venv_path.is_dir():
            return venv_path

        # Then check for venv
        venv_path = dir_path / "venv"
        if venv_path.is_dir():
            return venv_path

        # Move to parent
        parent = dir_path.parent
        if parent == dir_path:  # Reached root
            break
        dir_path = parent

    return None


def conda_env_exists(env_name):
    """Check if a conda environment exists"""
    try:
        # Compatible with Python 3.6+
        result = subprocess.run(
            ["conda", "env", "list"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            check=True
        )
        # Parse conda env list output
        for line in result.stdout.split('\n'):
            if line.strip() and not line.startswith('#'):
                parts = line.split()
                if parts and parts[0] == env_name:
                    return True
        return False
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def activate_venv(venv_path, python_args, show_venv=False):
    """Activate venv and run python"""
    python_bin = venv_path / "bin" / "python"

    if not python_bin.exists():
        print("Error: Python not found in virtual environment:", file=sys.stderr)
        print("  {}".format(python_bin), file=sys.stderr)
        sys.exit(1)

    if show_venv:
        print("Using venv: {}".format(venv_path), file=sys.stderr)

    os.execv(str(python_bin), [str(python_bin)] + python_args)


def activate_conda(env_name, python_args):
    """Activate conda env and run python"""
    # Get conda path
    conda_base = Path.home() / "anaconda3"
    conda_bin = conda_base / "bin" / "conda"

    if not conda_bin.exists():
        print("Error: conda not found at {}".format(conda_bin), file=sys.stderr)
        sys.exit(1)

    # Build python command with proper escaping
    python_cmd_parts = []
    for arg in python_args:
        # Escape single quotes in arguments
        escaped = arg.replace("'", "'\\''")
        python_cmd_parts.append("'{}'".format(escaped))

    python_cmd = ' '.join(python_cmd_parts)

    # Create a shell script to activate conda and run python
    shell_script = """
eval "$({} shell.bash hook)" || exit 1
conda activate "{}" || exit 1
exec python {}
""".format(conda_bin, env_name, python_cmd)

    os.execv("/bin/bash", ["/bin/bash", "-c", shell_script])


def print_help():
    help_text = """py - unified Python environment runner

USAGE:
  py [--venv|--conda] [env] <script.py> [args...]  Run a Python script
  py [--venv|--conda] [env] -c "code"              Run inline Python code
  py [--venv|--conda] [env] -i                     Enter REPL
  py [--venv|--conda] [env] -c "code" -i           Run code then REPL
  py -h | --help                                   Show this help

MODES:
  --venv   Force virtual environment mode (searches for .venv or venv)
  --conda  Force conda environment mode (requires env name)

AUTO-DETECTION:
  If first argument is a directory path, uses venv mode
  If first argument is a string (not a directory), tries conda mode
  Warns if ambiguous but continues (prefers venv)

EXAMPLES:
  py -i                          # Use venv in current/parent dir
  py ml train.py                 # Use conda env 'ml'
  py . app/main.py               # Use venv in current dir
  py /path/to/project script.py  # Use venv in /path/to/project
  py --conda ml -c "print(42)"   # Force conda mode
  py --venv -i                   # Force venv mode
"""
    print(help_text)


def main():
    # Handle help early
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help']:
        print_help()
        sys.exit(0)

    # Parse mode flags
    force_mode = None
    args = sys.argv[1:]

    if args and args[0] == '--venv':
        force_mode = 'venv'
        args = args[1:]
    elif args and args[0] == '--conda':
        force_mode = 'conda'
        args = args[1:]

    # Determine environment
    env_arg = None
    mode = force_mode

    if args and not args[0].startswith('-'):
        potential_env = args[0]

        if force_mode == 'venv':
            # Treat as directory for venv search
            env_arg = potential_env
            args = args[1:]
        elif force_mode == 'conda':
            # Treat as conda env name
            env_arg = potential_env
            args = args[1:]
        else:
            # Auto-detect
            is_dir = os.path.isdir(potential_env) or potential_env == '.'
            is_conda = conda_env_exists(potential_env)

            if is_dir and is_conda:
                # Ambiguous case
                print("Warning: '{}' is both a directory and conda env. Using venv mode.".format(potential_env), file=sys.stderr)
                print("  Use --venv or --conda to force a specific mode.", file=sys.stderr)
                mode = 'venv'
                env_arg = potential_env
                args = args[1:]
            elif is_dir:
                mode = 'venv'
                env_arg = potential_env
                args = args[1:]
            elif is_conda:
                mode = 'conda'
                env_arg = potential_env
                args = args[1:]
            else:
                # Not a dir, not a conda env - might be a script or flag
                # Default to venv mode with current directory
                mode = 'venv'
                env_arg = None
    else:
        # No env arg or starts with flag - default to venv
        if not mode:
            mode = 'venv'

    # Parse Python arguments (-c, -i, script, etc.)
    python_args = []

    if not args:
        # No arguments - interactive mode
        python_args = ['-i']
    else:
        # Parse arguments similar to bython/vython
        while args:
            if args[0] == '-c' and len(args) > 1:
                python_args.extend(['-c', args[1]])
                args = args[2:]
            elif args[0] == '-i':
                python_args.append('-i')
                args = args[1:]
            elif args[0] in ['-h', '--help']:
                print_help()
                sys.exit(0)
            else:
                # Script and its arguments
                python_args.extend(args)
                break

    # Execute based on mode
    if mode == 'venv':
        venv_path = find_venv(env_arg)

        if not venv_path:
            print("Error: No virtual environment found (.venv or venv)", file=sys.stderr)
            print("Searched current directory and parents.", file=sys.stderr)
            print("", file=sys.stderr)
            print("To create one: python -m venv .venv", file=sys.stderr)
            sys.exit(1)

        activate_venv(venv_path, python_args, show_venv=(python_args == ['-i']))

    elif mode == 'conda':
        if not env_arg:
            print("Error: No conda environment name provided.", file=sys.stderr)
            print("Run 'py --help' for usage.", file=sys.stderr)
            sys.exit(1)

        activate_conda(env_arg, python_args)

    else:
        print("Error: Unable to determine mode.", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
