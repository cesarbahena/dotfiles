#!/bin/bash
# bython - run Python inside a specific conda environment
# Usage:
#   bython <env>                      (activate only)
#   bython <env> script.py [args...]  (run script)
#   bython <env> -c "code"            (inline code)
#   bython <env> [-c "code"] -i       (interactive REPL)
#   bython --help                     (show help)

print_help() {
    cat <<EOF
bython - run Python inside a Conda environment

USAGE:
  bython <env>                        Activate environment only
  bython <env> <script.py> [args...]  Run a Python script
  bython <env> -c "code"              Run inline Python code
  bython <env> [-c "code"] -i         Enter REPL after running code/script
  bython -h | --help                  Show this help

EXAMPLES:
  bython ml train.py --epochs 10
  bython data -c "print(42)"
  bython vision -c "print('hi')" -i
  bython ds -i
EOF
}

# Global help (must be first arg)
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    print_help
    exit 0
fi

ENV_NAME="$1"
shift

if [ -z "$ENV_NAME" ]; then
    echo "Error: No environment name provided."
    echo "Run 'bython --help' for usage."
    exit 1
fi

# Detect help requests AFTER env name:
for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        print_help
        exit 0
    fi
done

# Flags
INLINE_CODE=""
INTERACTIVE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c)
            INLINE_CODE="$2"
            shift 2
            ;;
        -i)
            INTERACTIVE=1
            shift
            ;;
        *)
            SCRIPT="$1"
            shift
            SCRIPT_ARGS=("$@")
            break
            ;;
    esac
done

# Initialize conda
eval "$($HOME/anaconda3/bin/conda shell.bash hook)" || {
    echo "Error: Failed to initialize conda"
    exit 1
}

# Activate environment
conda activate "$ENV_NAME" || {
    echo "Error: Failed to activate environment '$ENV_NAME'"
    exit 1
}

# --- Behavior modes ---
# 1. Interactive REPL only
if [[ -z "$INLINE_CODE" && -z "$SCRIPT" && $INTERACTIVE -eq 1 ]]; then
    exec python -i
fi

# 2. Inline code
if [[ -n "$INLINE_CODE" ]]; then
    if [[ $INTERACTIVE -eq 1 ]]; then
        exec python -c "$INLINE_CODE" -i
    else
        exec python -c "$INLINE_CODE"
    fi
fi

# 3. Script execution
if [[ -n "$SCRIPT" ]]; then
    if [[ $INTERACTIVE -eq 1 ]]; then
        exec python "$SCRIPT" "${SCRIPT_ARGS[@]}" -i
    else
        exec python "$SCRIPT" "${SCRIPT_ARGS[@]}"
    fi
fi

# 4. Env-only mode
exec $SHELL
