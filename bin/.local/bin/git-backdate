#!/bin/bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print error and exit
error_exit() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    exit 1
}

# Function to print success
success() {
    echo -e "${GREEN}SUCCESS: $1${NC}"
}

# Function to print warning
warning() {
    echo -e "${YELLOW}WARNING: $1${NC}"
}

# Function to check if file contains "dont commit" variations
contains_dont_commit() {
    local file="$1"
    grep -qiE "(don't|dont|do not) commit" "$file" 2>/dev/null
}

# Function to show next action (state machine)
show_what() {
    # Auto-init repo if needed
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        git init >/dev/null 2>&1
    fi

    # Check for merge conflicts
    if git diff --name-only --diff-filter=U 2>/dev/null | grep -q .; then
        echo "ABORT: Merge conflicts detected"
        echo "Return to parent agent"
        exit 1
    fi

    # Case A: Has staged files
    STAGED=$(git diff --cached --name-only 2>/dev/null)
    if [ -n "$STAGED" ]; then
        LAST_COMMIT=$(git log -1 --format="%cd" --date=format:"%Y-%m-%d %H:%M" 2>/dev/null || echo "1970-01-01 00:00")

        echo "Estimate a date YYYY-MM-DD and time HH:mm since $LAST_COMMIT enough to make these changes:"
        git diff --staged
        echo ""
        echo "Commit with git backdate DATE TIME \"message\""
        exit 0
    fi

    # Case B: Has untracked or unstaged
    UNTRACKED=$(git ls-files --others --exclude-standard 2>/dev/null | while read -r f; do
        contains_dont_commit "$f" || echo "$f"
    done)
    UNSTAGED=$(git diff --name-only 2>/dev/null)

    if [ -n "$UNTRACKED" ] || [ -n "$UNSTAGED" ]; then
        echo "Make 1 group of related changes:"
        echo ""
        git backdate which
        echo "Add with: git backdate add <files>"
        echo "Commit with: git backdate DATE TIME \"message\""
        exit 0
    fi

    # Case C: Clean
    echo "JOB FINISHED: Working tree clean"
    exit 0
}

# Function to show token-efficient report
show_which() {
    # Show untracked files (excluding "dont commit")
    git ls-files --others --exclude-standard 2>/dev/null | while read -r file; do
        if ! contains_dont_commit "$file"; then
            echo "UNTRACKED|$file"
            cat "$file" | sed -En '
                s/[ \t]+/ /g;
                s/^[ \t]+//;
                s/[ \t]+$//;
                /^$/d;
                1,500p
            '
        fi
    done

    # Show unstaged changes
    git diff --name-only 2>/dev/null | while read -r file; do
        echo "UNSTAGED|$file"
        git diff -U2 "$file" | grep -vE '^(index |diff --git |@@ |--- |\+\+\+ )' | sed -En 's/^[ \t]+$//; /^$/d; 1,500p'
    done

    exit 0
}

# Function to safely add files
do_add() {
    if [ $# -eq 0 ]; then
        error_exit "No files specified. Usage: git backdate add <file1> <file2> ..."
    fi

    # Check for '.' argument
    for arg in "$@"; do
        if [ "$arg" = "." ]; then
            error_exit "Cannot use '.' - specify files explicitly"
        fi
    done

    # Check each file for "dont commit"
    for file in "$@"; do
        if [ -f "$file" ] && contains_dont_commit "$file"; then
            error_exit "Cannot add '$file' - contains 'dont commit' directive"
        fi
    done

    # All checks passed, add files
    git add "$@"
    exit 0
}

# Function to show help
show_help() {
    cat << 'EOF'
git-backdate - Create backdated commits with work hour validation

SYNOPSIS:
    git backdate what
    git backdate which
    git backdate add <file> [<file>...]
    git backdate [--overtime] <YYYY-MM-DD> <HH:MM> <message>

DESCRIPTION:
    Git external command that creates commits with custom backdated timestamps
    while enforcing realistic work patterns. Designed for LLM agents to maintain
    organic commit histories through a state machine workflow.

    This command is discoverable via 'git help -a' under "External commands".

SUBCOMMANDS:
    what    Show next action in commit workflow (state machine)
            Examines git state and outputs single instruction for LLM.
            Auto-initializes repo if needed. After successful commits,
            this is called automatically to show next step.

    which   Show token-efficient report of untracked and unstaged files
            Outputs file paths with trimmed content for LLM grouping.
            Files containing "dont commit" are excluded.

    add     Safely stage files for commit
            Prevents staging files with "dont commit" directives.
            Prevents using '.' - requires explicit file listing.

ARGUMENTS:
    <YYYY-MM-DD>    Commit date (e.g., 2025-01-15)
    <HH:MM>         Commit time (e.g., 09:23)
    <message>       Commit message

OPTIONS:
    --overtime      Allow commits outside regular work hours or on weekends
    -h, --help      Show this help message

VALIDATION RULES:
    1. Time Sequence: Commits must be at least 1 minute after the last commit
    
    2. Work Hours: Regular commits allowed 08:00-19:00 (Mon-Fri only)
       - Use --overtime flag for commits outside these hours or on weekends
    
    3. Organic Timing: Minutes cannot be :00, :15, :30, or :45
       - Valid examples: :07, :23, :38, :52
       - Seconds are automatically randomized (1-59)
    
    4. Staged Files: Files must be staged with git add before committing

OUTPUT:
    After successful commit, displays:
    - List of committed files
    - Commit datetime with random seconds
    - Remaining unstaged/untracked files (if any)
    - Working tree status

EXAMPLES:
    # LLM agent workflow
    $ git backdate what
    Make 1 group of related changes:
    UNTRACKED|newfile.js
    ...
    Add with: git backdate add <files>
    Commit with: git backdate DATE TIME "message"

    $ git backdate add newfile.js utils.js
    $ git backdate 2025-01-15 09:23 "Add user authentication"
    SUCCESS: Commit created successfully!
    ...
    ----------------------------------------
    JOB FINISHED: Working tree clean

    # Manual commit (regular work hour)
    git backdate 2025-01-15 09:23 "Add user authentication"

    # Manual commit (weekend overtime work)
    git backdate --overtime 2025-01-18 14:17 "Fix critical bug"

    # Manual commit (late evening work)
    git backdate --overtime 2025-01-15 20:42 "Deploy hotfix"

ERRORS:
    The tool will reject commits that:
    - Are before or within 1 minute of the last commit
    - Use quarter-hour times (:00, :15, :30, :45)
    - Are on weekends without --overtime flag
    - Are outside 08:00-19:00 without --overtime flag
    - Have no staged files

    All errors include helpful suggestions for valid alternatives.

LLM WORKFLOW:
    1. Call: git backdate what
    2. Follow the instruction shown:

       Case A - Staged files exist:
         → Calculate development time for changes
         → Execute: git backdate YYYY-MM-DD HH:MM "message"
         → Script auto-shows next instruction

       Case B - Untracked/unstaged changes:
         → Review report from embedded "git backdate which" output
         → Stage related group: git backdate add <files>
         → Calculate time and commit: git backdate YYYY-MM-DD HH:MM "message"
         → Script auto-shows next instruction

       Case C - Working tree clean:
         → Job finished, stop

       Case D - Merge conflicts:
         → Abort, return to parent agent

    3. Repeat from step 1 (script auto-calls "what" after commits)

LLM INTEGRATION NOTES:
    - Use non-quarter hour times (vary minutes: :07, :23, :38, :52, etc.)
    - Only use git backdate add (NOT git add) - prevents "dont commit" files
    - Add realistic development time based on complexity of changes
    - Files containing "dont commit" are invisible to the workflow

INSTALLATION:
    Place git-backdate executable in your PATH (e.g., ~/dotfiles/bin/.local/bin/).
    Git will automatically discover it as an external command.
    
    Verify installation:
        git help -a | grep backdate

SEE ALSO:
    git-add(1), git-commit(1), git-log(1)
    
    Git external commands documentation:
        git help -a
EOF
    exit 0
}

# Handle subcommands
case "$1" in
    what)
        show_what
        ;;
    which)
        show_which
        ;;
    add)
        shift
        do_add "$@"
        ;;
    -h|--help)
        show_help
        ;;
esac

# Parse arguments for regular commit
OVERTIME=false
DATE=""
TIME=""
MESSAGE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            ;;
        --overtime)
            OVERTIME=true
            shift
            ;;
        *)
            if [ -z "$DATE" ]; then
                DATE="$1"
            elif [ -z "$TIME" ]; then
                TIME="$1"
            elif [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            else
                error_exit "Too many arguments. Usage: git backdate [--overtime] <date> <time> <message>"
            fi
            shift
            ;;
    esac
done

# Validate required arguments
if [ -z "$DATE" ] || [ -z "$TIME" ] || [ -z "$MESSAGE" ]; then
    error_exit "Usage: git backdate [--overtime] <YYYY-MM-DD> <HH:MM> <message>"
fi

# Validate date format
if ! [[ "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    error_exit "Invalid date format. Use YYYY-MM-DD"
fi

# Validate time format
if ! [[ "$TIME" =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
    error_exit "Invalid time format. Use HH:MM"
fi

# Extract hour and minute
HOUR=$(echo "$TIME" | cut -d: -f1)
MINUTE=$(echo "$TIME" | cut -d: -f2)

# Check if minutes are on quarters (00, 15, 30, 45)
if [ "$MINUTE" = "00" ] || [ "$MINUTE" = "15" ] || [ "$MINUTE" = "30" ] || [ "$MINUTE" = "45" ]; then
    error_exit "Cannot use quarter hours ($MINUTE minutes). Use more organic times like :07, :23, :38, etc."
fi

# Generate random seconds (1-59, avoiding 00)
SECONDS=$((RANDOM % 59 + 1))
SECONDS=$(printf "%02d" $SECONDS)

# Construct full datetime
DATETIME="$DATE $TIME:$SECONDS"

# Convert to timestamp for comparisons
COMMIT_TIMESTAMP=$(date -d "$DATETIME" +%s 2>/dev/null) || error_exit "Invalid date/time: $DATETIME"

# Get last commit date
LAST_COMMIT_DATE=$(git log -1 --format=%ai 2>/dev/null || echo "")

if [ -n "$LAST_COMMIT_DATE" ]; then
    LAST_COMMIT_TIMESTAMP=$(date -d "$LAST_COMMIT_DATE" +%s)
    
    # Check if new commit is at least 1 minute after last commit
    TIME_DIFF=$((COMMIT_TIMESTAMP - LAST_COMMIT_TIMESTAMP))
    
    if [ $TIME_DIFF -lt 60 ]; then
        LAST_COMMIT_FORMATTED=$(date -d "$LAST_COMMIT_DATE" "+%Y-%m-%d %H:%M:%S")
        error_exit "Cannot commit before or within 1 minute of last commit.
Last commit: $LAST_COMMIT_FORMATTED

Please evaluate the development time needed for the changes you've made.
Consider the complexity and add appropriate time to: $LAST_COMMIT_FORMATTED

Suggestion: Add at least 5-30 minutes of development time to the last commit date."
    fi
fi

# Check if date is weekend
DAY_OF_WEEK=$(date -d "$DATE" +%u) # 1=Monday, 7=Sunday

if [ "$OVERTIME" = false ]; then
    # Regular work hours check
    if [ "$DAY_OF_WEEK" -eq 6 ] || [ "$DAY_OF_WEEK" -eq 7 ]; then
        # Find next Monday
        NEXT_MONDAY=$(date -d "$DATE + $((8 - DAY_OF_WEEK)) days" +%Y-%m-%d)
        error_exit "Cannot commit on weekends (Saturday/Sunday) during regular hours.

Suggestion: Use next workday: $NEXT_MONDAY
Alternative: Use --overtime flag if this was weekend work"
    fi
    
    # Check work hours (8 AM to 7 PM = 08:00 to 19:00)
    HOUR_INT=$((10#$HOUR))
    if [ $HOUR_INT -lt 8 ] || [ $HOUR_INT -ge 19 ]; then
        # Calculate next valid time
        if [ $HOUR_INT -ge 19 ]; then
            # After 7 PM, suggest next day 8 AM
            NEXT_DATE=$(date -d "$DATE + 1 day" +%Y-%m-%d)
            NEXT_DAY_OF_WEEK=$(date -d "$NEXT_DATE" +%u)
            
            # Skip to Monday if next day is weekend
            if [ "$NEXT_DAY_OF_WEEK" -eq 6 ]; then
                NEXT_DATE=$(date -d "$NEXT_DATE + 2 days" +%Y-%m-%d)
            elif [ "$NEXT_DAY_OF_WEEK" -eq 7 ]; then
                NEXT_DATE=$(date -d "$NEXT_DATE + 1 day" +%Y-%m-%d)
            fi
            
            SUGGESTED_TIME="08:07"
        else
            # Before 8 AM, suggest same day 8 AM
            SUGGESTED_TIME="08:07"
        fi
        
        error_exit "Cannot commit outside work hours (8:00-19:00).
Current time: $TIME

Suggestion: Use work hours: $SUGGESTED_TIME
Alternative: Use --overtime flag if this was overtime work"
    fi
else
    # Overtime check (opposite of work hours)
    if [ "$DAY_OF_WEEK" -ge 1 ] && [ "$DAY_OF_WEEK" -le 5 ]; then
        # Weekday - check if during work hours
        HOUR_INT=$((10#$HOUR))
        if [ $HOUR_INT -ge 8 ] && [ $HOUR_INT -lt 19 ]; then
            # During work hours but overtime flag set
            SUGGESTED_TIME="19:42"
            error_exit "Overtime flag is set but time is during regular work hours (8:00-19:00).

Suggestion: Remove --overtime flag for work hour commits
Alternative: Use overtime hours: $SUGGESTED_TIME"
        fi
    fi
    
    # If overtime on weekday before/after hours, that's fine
    # If overtime on weekend, that's also fine
fi

# Get staged files before commit
STAGED_FILES=$(git diff --cached --name-only)
if [ -z "$STAGED_FILES" ]; then
    error_exit "No files staged for commit. Use 'git add' first."
fi

# Construct the git commit command with environment variable
export GIT_COMMITTER_DATE="$DATETIME"
export GIT_AUTHOR_DATE="$DATETIME"

# Perform the commit
if git commit --date="$DATETIME" -m "$MESSAGE"; then
    echo ""
    success "Commit created successfully!"
    echo ""
    echo "Committed files:"
    echo "$STAGED_FILES" | while read -r file; do
        echo "  - $file"
    done
    echo ""
    echo "Commit datetime: $DATETIME"
    echo ""
    echo "----------------------------------------"
    echo ""

    # Auto-call "what" to show next instruction
    show_what
else
    error_exit "Git commit failed"
fi
