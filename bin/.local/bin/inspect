#!/bin/bash
# inspect - supercharged file inspection with custom color coding
# Features:
# - Username with permission-aware colors
# - Numeric permissions (755) with security pattern highlighting
# - Size with practicality color coding
# - Time ago with git status colors
# - Tree view by default with hidden files

set -euo pipefail

# ANSI color codes
declare -A COLORS=(
    # User/ownership colors
    [user_current]='\033[0m'        # Current user (default)
    [user_denied]='\033[1;31m'      # No permission
    [user_group]='\033[1;34m'       # Group access
    [user_others]='\033[1;32m'      # Others access
    [user_different]='\033[1;33m'   # Different user but accessible

    # Permission pattern colors
    [perm_danger]='\033[1;91m'      # 777, 666 - world writable
    [perm_warning]='\033[1;93m'     # x7x, xx7 - others/group writable
    [perm_secure]='\033[1;92m'      # 700, 600 - owner only
    [perm_exec]='\033[1;96m'        # Executable files
    [perm_normal]='\033[0;90m'      # Everything else

    # Size colors
    [size_tiny]='\033[0;90m'        # < 1KB
    [size_small]='\033[0;37m'       # 1KB - 100KB
    [size_medium]='\033[1;33m'      # 100KB - 10MB
    [size_large]='\033[1;31m'       # > 10MB

    # Git status colors (for time field)
    [git_untracked]='\033[1;32m'    # Untracked/new
    [git_modified]='\033[1;33m'     # Modified
    [git_conflict]='\033[1;31m'     # Conflict
    [git_staged]='\033[1;36m'       # Staged
    [git_clean]='\033[0;37m'        # Clean

    [reset]='\033[0m'
    [bold]='\033[1m'
    [dim]='\033[2m'
)

# Configuration
CURRENT_USER="$(whoami)"
CURRENT_UID="$(id -u)"
CURRENT_GROUPS="$(id -G)"
TARGET="."

show_help() {
    cat <<'EOF'
inspect - supercharged file inspection with intelligent color coding

USAGE:
  inspect [options] [path]

OPTIONS:
  -h, --help       Show this help
  -a, --all        Show all files recursively
  -s, --sizes      Show sizes for all files (default: only large files)

COLOR CODING:
  Username/Owner:
    Default         Current user
    Red             No access (permission denied)
    Blue            Access via group
    Green           Unrestricted (others readable)
    Yellow          Different owner but accessible

  Permissions (octal):
    Bright Red      Dangerous (777, 666, world-writable)
    Bright Yellow   Warning (x7x, group/others writable)
    Bright Green    Secure (700, 600, owner-only)
    Bright Cyan     Executable
    Dark Gray       Normal

  Size:
    Dark Gray       < 1KB
    White           1KB - 100KB
    Yellow          100KB - 10MB
    Red             > 10MB

  Modified Time (git-aware):
    Green           Untracked (new)
    Yellow          Modified (uncommitted)
    Red             Conflict
    Cyan            Staged
    White           Clean (committed)

EXAMPLES:
  inspect                  # Current directory
  inspect ~/project        # Specific directory
  inspect -a /etc/nginx    # Recursive listing

EOF
}

# Parse arguments
RECURSE=0
SHOW_ALL_SIZES=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        -a|--all) RECURSE=1; shift ;;
        -s|--sizes) SHOW_ALL_SIZES=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) TARGET="$1"; shift ;;
    esac
done

# Helper: Get git status for file
get_git_status() {
    local file="$1"
    local git_root git_status status_code

    git_root="$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null)" || return 1
    git_status="$(cd "$git_root" && git status --porcelain=v1 "$file" 2>/dev/null)" || return 1

    status_code="${git_status:0:2}"

    case "$status_code" in
        "??") echo "untracked" ;;
        "M "|" M"|"MM") echo "modified" ;;
        "A "|"AM") echo "staged" ;;
        "UU"|"AA"|"DD") echo "conflict" ;;
        "") echo "clean" ;;
        *) echo "clean" ;;
    esac
}

# Helper: Get permission color (returns just the color code)
get_perm_color() {
    local perm="$1"
    local color

    # Check for dangerous patterns
    if [[ "$perm" =~ 777|666 ]]; then
        color="${COLORS[perm_danger]}"
    elif [[ "$perm" =~ [0-9]7[0-9]|[0-9][0-9]7 ]]; then
        color="${COLORS[perm_warning]}"
    elif [[ "$perm" =~ 700|600|400 ]]; then
        color="${COLORS[perm_secure]}"
    elif [[ "$perm" =~ [1357]$ ]]; then
        color="${COLORS[perm_exec]}"
    else
        color="${COLORS[perm_normal]}"
    fi

    printf "%s" "${color}"
}

# Helper: Colorize size
colorize_size() {
    local size_bytes="$1"
    local size_human="$2"
    local color

    if [[ $size_bytes -lt 1024 ]]; then
        color="${COLORS[size_tiny]}"
    elif [[ $size_bytes -lt 102400 ]]; then
        color="${COLORS[size_small]}"
    elif [[ $size_bytes -lt 10485760 ]]; then
        color="${COLORS[size_medium]}"
    else
        color="${COLORS[size_large]}"
    fi

    printf "%s" "${color}${size_human}${COLORS[reset]}"
}

# Helper: Colorize owner based on permissions
colorize_owner() {
    local owner="$1"
    local perm_octal="$2"
    local file_uid="$3"
    local file_gid="$4"
    local color="${COLORS[user_current]}"

    # Check if current user
    if [[ "$file_uid" != "$CURRENT_UID" ]]; then
        # Different user - check access
        local user_perm="${perm_octal:0:1}"
        local group_perm="${perm_octal:1:1}"
        local other_perm="${perm_octal:2:1}"

        # Check if we have access
        if [[ $other_perm -ge 4 ]]; then
            color="${COLORS[user_others]}"
        elif echo "$CURRENT_GROUPS" | grep -q "$file_gid" && [[ $group_perm -ge 4 ]]; then
            color="${COLORS[user_group]}"
        elif [[ $user_perm -lt 4 ]]; then
            color="${COLORS[user_denied]}"
        else
            color="${COLORS[user_different]}"
        fi
    fi

    printf "%s" "${color}${owner}${COLORS[reset]}"
}

# Helper: Colorize time based on git status
colorize_time() {
    local time_str="$1"
    local git_stat="$2"
    local color

    case "$git_stat" in
        untracked) color="${COLORS[git_untracked]}" ;;
        modified)  color="${COLORS[git_modified]}" ;;
        conflict)  color="${COLORS[git_conflict]}" ;;
        staged)    color="${COLORS[git_staged]}" ;;
        *)         color="${COLORS[git_clean]}" ;;
    esac

    printf "%s" "${color}${time_str}${COLORS[reset]}"
}

# Helper: Human readable size
human_size() {
    local bytes="$1"
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( bytes / 1024 ))K"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( bytes / 1048576 ))M"
    else
        echo "$(( bytes / 1073741824 ))G"
    fi
}

# Helper: Relative time
relative_time() {
    local timestamp="$1"
    local now="$(date +%s)"
    local diff=$((now - timestamp))

    if [[ $diff -lt 60 ]]; then
        echo "now"
    elif [[ $diff -lt 3600 ]]; then
        echo "$((diff / 60))m"
    elif [[ $diff -lt 86400 ]]; then
        echo "$((diff / 3600))h"
    elif [[ $diff -lt 604800 ]]; then
        echo "$((diff / 86400))d"
    elif [[ $diff -lt 2592000 ]]; then
        echo "$((diff / 604800))w"
    elif [[ $diff -lt 31536000 ]]; then
        echo "$((diff / 2592000))mo"
    else
        echo "$((diff / 31536000))y"
    fi
}

# Main listing function
list_files() {
    local target="$1"

    # Get files (including hidden)
    local find_opts="-maxdepth 1"
    [[ $RECURSE -eq 1 ]] && find_opts=""

    local files=()
    while IFS= read -r -d $'\0' file; do
        files+=("$file")
    done < <(find "$target" $find_opts -mindepth 1 -print0 2>/dev/null | sort -z)

    # First pass: calculate max widths
    local max_owner_perm=0
    local max_time=0

    for file in "${files[@]}"; do
        [[ "$file" == "$target" ]] && continue
        local basename="$(basename "$file")"
        [[ "$basename" == "." || "$basename" == ".." ]] && continue

        local stat_output
        stat_output="$(stat -c "%U %a %s %Y" "$file" 2>/dev/null)" || continue
        read -r owner perm_oct size mtime <<< "$stat_output"

        local owner_len=${#owner}
        local perm_len=3
        local owner_perm_total=$((owner_len + perm_len))
        [[ $owner_perm_total -gt $max_owner_perm ]] && max_owner_perm=$owner_perm_total

        local time_rel="$(relative_time "$mtime")"
        local time_len=${#time_rel}
        [[ $time_len -gt $max_time ]] && max_time=$time_len
    done

    # Second pass: print with calculated widths
    for file in "${files[@]}"; do
        [[ "$file" == "$target" ]] && continue

        local basename="$(basename "$file")"
        [[ "$basename" == "." || "$basename" == ".." ]] && continue

        # Get file stats
        local stat_output
        stat_output="$(stat -c "%U %u %g %a %s %Y" "$file" 2>/dev/null)" || continue
        read -r owner uid gid perm_oct size mtime <<< "$stat_output"

        # Get git status
        local git_stat="$(get_git_status "$file")"
        [[ -z "$git_stat" ]] && git_stat="clean"

        # Format components
        local perm_color="$(get_perm_color "$perm_oct")"
        local owner_colored="$(colorize_owner "$owner" "$perm_oct" "$uid" "$gid")"
        local size_human="$(human_size "$size")"
        local size_colored="$(colorize_size "$size" "$size_human")"
        local time_rel="$(relative_time "$mtime")"
        local time_colored="$(colorize_time "$time_rel" "$git_stat")"

        # Get eza-style colored filename (strip ./ prefix including color codes)
        # Use -d flag to treat directories as files, not list their contents
        local colored_name
        colored_name="$(eza --color=always -d --oneline "$file" 2>/dev/null | tail -1 | sed -E 's|^(\x1b\[[0-9;]*m)*\./(\x1b\[[0-9;]*m)*||')"
        [[ -z "$colored_name" ]] && colored_name="$basename"

        # Format owner with subscript permissions using Unicode subscript digits
        # Subscript mapping: 0₀ 1₁ 2₂ 3₃ 4₄ 5₅ 6₆ 7₇ 8₈ 9₉
        local perm_subscript=""
        for (( i=0; i<${#perm_oct}; i++ )); do
            case "${perm_oct:$i:1}" in
                0) perm_subscript+="₀" ;;
                1) perm_subscript+="₁" ;;
                2) perm_subscript+="₂" ;;
                3) perm_subscript+="₃" ;;
                4) perm_subscript+="₄" ;;
                5) perm_subscript+="₅" ;;
                6) perm_subscript+="₆" ;;
                7) perm_subscript+="₇" ;;
                8) perm_subscript+="₈" ;;
                9) perm_subscript+="₉" ;;
            esac
        done

        # Calculate visible widths
        local owner_len=${#owner}
        local perm_len=3  # Subscripts are 3 chars (e.g., ₇₅₅)
        local time_len=${#time_rel}

        # Calculate padding needed (use dynamic max widths)
        local owner_perm_total=$((owner_len + perm_len))
        local pad1=$((max_owner_perm - owner_perm_total))
        local pad2=$((max_time - time_len))

        [[ $pad1 -lt 0 ]] && pad1=0
        [[ $pad2 -lt 0 ]] && pad2=0

        # Determine if we should show size
        # Size threshold: show if > 10MB or if SHOW_ALL_SIZES flag is set
        local size_suffix=""
        local size_threshold=10485760  # 10MB in bytes

        if [[ $SHOW_ALL_SIZES -eq 1 ]]; then
            size_suffix=" ${size_colored}"
        elif [[ $size -gt $size_threshold ]]; then
            # Show large file warning in red/yellow
            size_suffix=" ${COLORS[size_large]}${size_human}${COLORS[reset]}"
        fi

        # Print the line with proper spacing
        printf "%b%b%b%*s  %b%*s  %b%b\n" \
            "$owner_colored" \
            "$perm_color" \
            "$perm_subscript${COLORS[reset]}" \
            "$pad1" "" \
            "$time_colored" \
            "$pad2" "" \
            "$colored_name" \
            "$size_suffix"
    done
}

# Execute listing
list_files "$TARGET"
