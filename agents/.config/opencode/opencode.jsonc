{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cd*": "allow",
      "pwd*": "allow",
      "mkdir*": "allow",
      "ps*": "allow",
      "sleep*": "allow",
      "kill*": "deny",
      "grep*": "allow",
      "rg*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "find*": "deny",
      "cp*": "allow",
      "mv*": "allow",
      "rm*": "ask",
      "sudo*": "deny",
      "echo*": "allow",
      "sed*": "deny",
      "awk*": "deny",
      "touch*": "allow",
      "cat*": "allow",
      "which*": "allow",
      "du*": "allow",
      "diff*": "allow",
      "wc*": "allow",
      "tar*": "allow",
      "git*": "allow",
      "npm*": "allow",
      "uv*": "allow",
      "pip*": "allow",
      "python*": "allow",
      "pytest*": "allow",
      "source*": "allow",
      "make*": "allow",
      "curl*": "allow",
      "docker*": "allow",
      "mysql*": "allow",
      "mysqldump*": "allow",
      "php": "allow",
      "jq*": "allow",
      "yq*": "allow",
      "gh*": "allow",
      "vendor/bin/*": "allow"
    }
  }
}
