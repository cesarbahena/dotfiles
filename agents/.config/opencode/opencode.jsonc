{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cd*": "allow",
      "pwd*": "allow",
      "mkdir*": "allow",
      "ps*": "allow",
      "sleep*": "allow",
      "kill*": "deny",
      "grep*": "deny",
      "rg*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "find*": "deny",
      "cp*": "allow",
      "mv*": "allow",
      "rm*": "ask",
      "sudo*": "deny",
      "echo*": "deny",
      "sed*": "deny",
      "awk*": "deny",
      "printf*": "deny",
      "touch*": "deny",
      "tee*": "deny",
      "cat*": "deny",
      "which*": "allow",
      "du*": "allow",
      "diff*": "allow",
      "wc*": "allow",
      "tar*": "allow",
      "git": "ask",
      "npm*": "deny",
      "pnpm*": "allow",
      "uv*": "allow",
      "pip*": "deny",
      "python*": "allow",
      "pytest*": "allow",
      "source*": "allow",
      "make*": "allow",
      "curl*": "allow",
      "docker*": "allow",
      "sleep*": "allow"
    }
  },
}
