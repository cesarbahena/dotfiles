{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cd*": "allow",
      "pwd*": "allow",
      "mkdir*": "allow",
      "ps*": "allow",
      "sleep*": "allow",
      "kill*": "deny",
      "grep*": "allow",
      "rm": "deny",
      "sudo*": "deny",
      "echo": "deny",
      "cat": "deny",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git": "ask",
      "npm*": "deny",
      "pnpm*": "allow",
      "uv*": "allow",
      "pip*": "deny",
      "python*": "allow",
      "pytest*": "allow",
      "source*": "allow",
      "make*": "allow",
      "curl*": "deny",
      "docker*": "ask"
    }
  },
}
