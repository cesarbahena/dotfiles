{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./.opencode/AGENTS.md"],
  "keybinds": {
    "leader": "ctrl+o",
    "messages_half_page_up": "alt+u",
    "messages_half_page_down": "ctrl+d",
    "session_compact": "none",
    "session_new": "<leader>c",
    "session_child_cycle": "<leader>ctrl+n,<leader>n",
    "session_child_cycle_reverse": "<leader>ctrl+p,<leader>p",
    "session_parent": "<leader>ctrl+k,<leader>k"
  },
  "permission": {
    "external_directory": {
      "*": "allow"
    }
  }
}
